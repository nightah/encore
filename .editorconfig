root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Templates control their own final newline: the generated files must match what's committed.
[*.tmpl]
insert_final_newline = unset
