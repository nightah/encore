# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Go
/encore
/bin/
/dist/
coverage.out
*.test
# make bench's output; published results live in benchmarks/results/.
/benchmarks/bench-*.txt
/benchmarks/bin/

# Web build output is embedded at build time, never committed.
internal/server/dist/*
!internal/server/dist/.gitkeep

# Web
web/node_modules/
web/test-results/
web/playwright-report/
web/coverage/

# Local runtime data
/data/
encore.yml

# Claude Code local state and agent worktrees
.claude/

# Docs reference pages generated by `go generate ./internal/docsgen` before every docs build.
/docs/src/content/docs/reference/configuration.md
/docs/src/content/docs/reference/cli.md
/docs/src/content/docs/voice-commands/*.md
!/docs/src/content/docs/voice-commands/index.md

# Personal Makefile overrides (see the Makefile).
/.local.mk
