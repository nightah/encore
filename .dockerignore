# Keep the build context small and free of local state.
.git
.github
.idea
.vscode
*.swp
.DS_Store

# Build outputs
/bin
/dist
/coverage.out
*.test

# Web: dependencies and outputs are rebuilt inside the image
web/node_modules
web/dist
web/coverage
web/playwright-report
web/test-results
internal/server/dist/*
!internal/server/dist/.gitkeep

# Documentation site: not part of the image
docs/node_modules
docs/dist
docs/.astro

# Local data / secrets
/data
.env
.env.*
*.pem
*.key

# Claude Code local state and agent worktrees
.claude
