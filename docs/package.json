{
  "name": "encore-docs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go -C .. generate ./internal/docsgen && astro build",
    "dev": "go -C .. generate ./internal/api && go -C .. generate ./internal/docsgen && astro dev",
    "format": "biome check --write . && sort-package-json package.json",
    "lint": "biome check . && sort-package-json --check package.json",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.9",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "sort-package-json": "4.1.0"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  }
}
